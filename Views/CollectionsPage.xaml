<Page
    x:Class="Stackd.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Stackd.Models"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="40,32,40,0" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Text="Collections" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnNewClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New collection" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Lista -->
        <Grid Grid.Row="1">
            <TextBlock Text="No collections yet. Press “New collection” to group your games into lists."
                       Style="{StaticResource SecondaryTextStyle}"
                       Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />

            <GridView ItemsSource="{x:Bind ViewModel.Collections}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnCollectionClick"
                      Padding="0,0,0,32">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:CollectionItem">
                        <StackPanel Width="220" Spacing="8">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Edit" Tag="{x:Bind}" Click="OnEditContextClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete" Tag="{x:Bind}" Click="OnDeleteContextClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>

                            <!-- Mosaico de 4 portadas -->
                            <Grid Width="220" Height="220" CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                                <Grid Visibility="{x:Bind HasGames}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Row="0" Grid.Column="0" Stretch="UniformToFill" Source="{x:Bind Cover1, Converter={StaticResource CachedImage}}" />
                                    <Image Grid.Row="0" Grid.Column="1" Stretch="UniformToFill" Source="{x:Bind Cover2, Converter={StaticResource CachedImage}}" />
                                    <Image Grid.Row="1" Grid.Column="0" Stretch="UniformToFill" Source="{x:Bind Cover3, Converter={StaticResource CachedImage}}" />
                                    <Image Grid.Row="1" Grid.Column="1" Stretch="UniformToFill" Source="{x:Bind Cover4, Converter={StaticResource CachedImage}}" />
                                </Grid>
                                <FontIcon Glyph="&#xE8F1;" FontSize="40" Foreground="{StaticResource MutedBrush}"
                                          Visibility="{x:Bind IsEmpty}" />
                            </Grid>

                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind CountLabel}" FontSize="12"
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
