<Page
    x:Class="Stackd.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <StackPanel Padding="40,32" Spacing="8">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
        <TextBlock x:Name="DescriptionText" Style="{StaticResource SecondaryTextStyle}" />
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,24,0,0" HorizontalAlignment="Left">
            <TextBlock Text="Próximamente: esta sección se construye en una fase posterior."
                       Style="{StaticResource SecondaryTextStyle}" />
        </Border>
    </StackPanel>
</Page>
