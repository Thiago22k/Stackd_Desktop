<Page
    x:Class="Stackd.Views.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Stackd.Models"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="40,32,40,40" Spacing="24">

            <!-- Encabezado y búsqueda -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock Text="Explore" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Discover new games and import them with IGDB"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <Button Grid.Column="1" VerticalAlignment="Center"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnConfigureCredentialsClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                        <TextBlock Text="IGDB Credentials" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Barra de búsqueda -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search games on IGDB (e.g. Witcher, Elden Ring, Zelda)..."
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown" />

                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{x:Bind ViewModel.SearchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="13" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ClearSearchCommand}">
                    <TextBlock Text="Clear" />
                </Button>
            </Grid>

            <!-- Banner de credenciales faltantes o errores -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.HasErrorMessage, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE783;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Content="Configure"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnConfigureCredentialsClick" />
                </Grid>
            </Border>

            <!-- Cargando -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="40" Height="40" HorizontalAlignment="Center" Margin="0,20" />

            <!-- RESULTADOS DE BÚSQUEDA -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}">
                <TextBlock Text="Search Results" Style="{StaticResource SectionTitleStyle}" />

                <TextBlock Text="No games found matching your search."
                           Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{x:Bind ViewModel.ShowSearchState, Mode=OneWay}" />

                <GridView ItemsSource="{x:Bind ViewModel.SearchResults}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnGameItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:IgdbGame">
                            <StackPanel Width="190" Spacing="8">
                                <Grid Height="253" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
                                    <Image Source="{Binding CoverDisplayUrl}" Stretch="UniformToFill" />
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                            Margin="8" CornerRadius="6" Padding="8,3"
                                            Background="#B30B0B14">
                                        <TextBlock Text="{x:Bind RatingLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Grid>
                                    <TextBlock Text="{x:Bind ReleaseYearLabel}" FontSize="12"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="In Library" HorizontalAlignment="Right"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource VioletBrush}"
                                               Visibility="{x:Bind IsInLibrary}" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <!-- SECCIONES DE EXPLORE (CUANDO NO SE ESTÁ BUSCANDO) -->
            <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.ShowExploreSections, Mode=OneWay}">
                
                <!-- POPULAR GAMES -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Popular Games" Style="{StaticResource SectionTitleStyle}" />

                    <GridView ItemsSource="{x:Bind ViewModel.PopularGames}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnGameItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:IgdbGame">
                                <StackPanel Width="190" Spacing="8">
                                    <Grid Height="253" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
                                        <Image Source="{Binding CoverDisplayUrl}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Margin="8" CornerRadius="6" Padding="8,3"
                                                Background="#B30B0B14">
                                            <TextBlock Text="{x:Bind RatingLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Grid>
                                        <TextBlock Text="{x:Bind GenresLabel}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Text="In Library" HorizontalAlignment="Right"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource VioletBrush}"
                                                   Visibility="{x:Bind IsInLibrary}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- MOST ANTICIPATED -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Most Anticipated" Style="{StaticResource SectionTitleStyle}" />

                    <GridView ItemsSource="{x:Bind ViewModel.MostAnticipatedGames}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnGameItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:IgdbGame">
                                <StackPanel Width="190" Spacing="8">
                                    <Grid Height="253" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
                                        <Image Source="{Binding CoverDisplayUrl}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Margin="8" CornerRadius="6" Padding="8,3"
                                                Background="#B30B0B14">
                                            <TextBlock Text="{x:Bind ReleaseYearLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Grid>
                                        <TextBlock Text="{x:Bind GenresLabel}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Text="In Library" HorizontalAlignment="Right"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource VioletBrush}"
                                                   Visibility="{x:Bind IsInLibrary}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
