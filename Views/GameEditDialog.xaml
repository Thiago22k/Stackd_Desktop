<ContentDialog
    x:Class="Stackd.Views.GameEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Stackd.Models"
    Title="Add game"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="540">
        <StackPanel Spacing="14" MinWidth="460" Padding="0,0,12,0">

            <!-- Ejecutable: al elegirlo se propone el título automáticamente -->
            <StackPanel Spacing="6">
                <TextBlock Text="Game executable" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutableBox" IsReadOnly="True"
                             PlaceholderText="Select the game's .exe" />
                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseClick" />
                    <Button Grid.Column="2" Content="Clear" Click="OnClearExecutableClick" />
                </Grid>
            </StackPanel>

            <!-- Título y botón Match IGDB -->
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" Header="Title" PlaceholderText="Game title" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Search and match with IGDB"
                            Click="OnMatchIgdbClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="12" />
                            <TextBlock Text="Match IGDB" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Name="IgdbMatchedBadge" Visibility="Collapsed"
                           FontSize="12" Foreground="{StaticResource VioletBrush}" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Panel inline de búsqueda IGDB (sin abrir otro ContentDialog) -->
            <Border x:Name="IgdbMatchPanel" Visibility="Collapsed"
                    Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="8" Padding="12"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Search on IGDB" FontWeight="SemiBold" FontSize="13" />
                        <Button HorizontalAlignment="Right" Content="✕" Width="26" Height="26" Padding="0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnCloseMatchPanelClick" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IgdbSearchBox" PlaceholderText="Search IGDB..."
                                 KeyDown="OnIgdbSearchKeyDown" />
                        <Button Grid.Column="1" Content="Search" Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnIgdbSearchClick" />
                    </Grid>

                    <ProgressRing x:Name="IgdbLoadingRing" IsActive="False" Visibility="Collapsed"
                                  Width="22" Height="22" HorizontalAlignment="Center" Margin="0,4" />

                    <TextBlock x:Name="IgdbStatusText" Visibility="Collapsed"
                               FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />

                    <ListView x:Name="IgdbResultsList" MaxHeight="200" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="OnIgdbResultItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:IgdbGame">
                                <Grid Padding="4,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Height="50" CornerRadius="4" Background="{StaticResource SurfaceBrush}">
                                        <Image Source="{Binding CoverDisplayUrl, Converter={StaticResource CachedImage}}" Stretch="UniformToFill" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind GenresLabel}" FontSize="11" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Text="{x:Bind ReleaseYearLabel}" FontSize="11"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <ComboBox x:Name="StatusBox" Header="Status" HorizontalAlignment="Stretch" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="HoursBox" Header="Hours played"
                           Minimum="0" Maximum="100000" SmallChange="1" LargeChange="5"
                           SpinButtonPlacementMode="Inline" Value="0" />
                <NumberBox x:Name="MinutesBox" Grid.Column="1" Header="Minutes"
                           Minimum="0" Maximum="59" SmallChange="5" LargeChange="15"
                           SpinButtonPlacementMode="Inline" Value="0" />
            </Grid>

            <CalendarDatePicker x:Name="LastPlayedPicker" Header="Last played (optional)"
                                PlaceholderText="Pick a date" />

            <TextBox x:Name="NotesBox" Header="Notes"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />

            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}" FontSize="13" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
