<Page
    x:Class="Stackd.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Stackd.Models"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <!-- Fila con posición, portada, título, barra y valor (Most played / Achievement progress) -->
        <DataTemplate x:Key="RankedRowTemplate" x:DataType="models:RankedRow">
            <Grid ColumnSpacing="12" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind Rank}" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" />

                <Grid Grid.Column="1" Width="36" Height="48" CornerRadius="4"
                      Background="{StaticResource SurfaceAltBrush}">
                    <Image Source="{x:Bind CoverUrl}" Stretch="UniformToFill" />
                </Grid>

                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Percent}"
                                 Height="6" CornerRadius="3"
                                 Foreground="{x:Bind Brush}"
                                 Background="{StaticResource SurfaceAltBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{x:Bind ValueLabel}" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="40,32,40,40" Spacing="24">

            <StackPanel Spacing="2">
                <TextBlock Text="Stats" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Your library at a glance" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <TextBlock Text="Add some games to your library and your stats will show up here."
                       Style="{StaticResource SecondaryTextStyle}"
                       Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />

            <StackPanel Spacing="24" Visibility="{x:Bind ViewModel.HasGames, Mode=OneWay}">

                <!-- Cifras principales -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="220" MinColumnSpacing="16" MinRowSpacing="16"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:StatCard">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource MetaTextStyle}" />
                                    <TextBlock Text="{x:Bind Value}" FontSize="30" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Caption}" FontSize="12" TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda: estados y datos sueltos -->
                    <StackPanel Grid.Column="0" Spacing="16">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Library by status" Style="{StaticResource SectionTitleStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.StatusRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StatusRow">
                                            <Grid Margin="0,0,0,12" RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{x:Bind Label}" FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind CountLabel}" FontSize="14" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{x:Bind Percent}"
                                                             Height="8" CornerRadius="4"
                                                             Foreground="{x:Bind Brush}"
                                                             Background="{StaticResource SurfaceAltBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Highlights" Style="{StaticResource SectionTitleStyle}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Highlights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:HighlightRow">
                                            <Grid Margin="0,0,0,8" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource SecondaryTextStyle}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" TextAlignment="Right" MaxWidth="260"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Columna derecha: rankings -->
                    <StackPanel Grid.Column="1" Spacing="16">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Most played" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="No playtime recorded yet. Play a game from Stackd or sync with Steam."
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.ShowNoPlaytime, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.MostPlayed}"
                                              ItemTemplate="{StaticResource RankedRowTemplate}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="20,16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Achievement progress" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="No achievement data yet. Link Steam and sync to see your progress."
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.ShowNoAchievements, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AchievementProgress}"
                                              ItemTemplate="{StaticResource RankedRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
