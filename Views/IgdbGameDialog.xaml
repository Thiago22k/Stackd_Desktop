<ContentDialog
    x:Class="Stackd.Views.IgdbGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Game Details"
    PrimaryButtonText="Add to Library"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="520">
        <Grid ColumnSpacing="20" MinWidth="520" Padding="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Portada -->
            <Grid Height="200" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                  VerticalAlignment="Top">
                <Image x:Name="CoverImage" Stretch="UniformToFill" />
            </Grid>

            <!-- Información -->
            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="6" Padding="8,3" Background="{StaticResource SurfaceBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock x:Name="RatingText" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="6" Padding="8,3" Background="{StaticResource SurfaceBrush}">
                        <TextBlock x:Name="YearText" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                    </Border>
                    <Border CornerRadius="6" Padding="8,3" Background="{StaticResource SurfaceBrush}">
                        <TextBlock x:Name="GenresText" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="13"
                           MaxHeight="180" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource SecondaryTextStyle}" />

                <ComboBox x:Name="StatusBox" Header="Initial Status" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>

