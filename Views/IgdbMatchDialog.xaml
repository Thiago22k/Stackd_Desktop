<ContentDialog
    x:Class="Stackd.Views.IgdbMatchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Stackd.Models"
    Title="Match with IGDB"
    PrimaryButtonText="Select"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="12" MinWidth="480">
        <TextBox x:Name="SearchBox" PlaceholderText="Search IGDB..."
                 KeyDown="OnSearchKeyDown" />

        <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed"
                      Width="28" Height="28" HorizontalAlignment="Center" Margin="0,10" />

        <TextBlock x:Name="NoResultsText" Text="No matching games found."
                   Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />

        <ListView x:Name="ResultsList" MaxHeight="320" SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:IgdbGame">
                    <Grid Padding="4,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Height="55" CornerRadius="4" Background="{StaticResource SurfaceBrush}">
                            <Image Source="{Binding CoverDisplayUrl}" Stretch="UniformToFill" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind GenresLabel}" FontSize="12" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                   Text="{x:Bind ReleaseYearLabel}" FontSize="12"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>

