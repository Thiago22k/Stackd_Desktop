<Page
    x:Class="Stackd.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Stackd.Models"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="40,32,40,40" Spacing="24">

            <!-- Saludo -->
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="What are you playing today?" Style="{StaticResource SecondaryTextStyle}" FontSize="17" />
            </StackPanel>

            <!-- Banner: Steam no vinculado -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.ShowLinkBanner, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="26" Foreground="{StaticResource VioletBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="STEAM ACCOUNT NOT LINKED" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Link your account now to enable game detection and automated data sync"
                                   Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Link Account"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnLinkSteamClick" />
                    <Button Grid.Column="3" Content="Dismiss"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{x:Bind ViewModel.DismissSteamBannerCommand}" />
                </Grid>
            </Border>

            <!-- Steam vinculado: estado y sincronización -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.IsSteamLinked, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="26" Foreground="{StaticResource VioletBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SteamTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SyncStatus, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}" FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ProgressRing Grid.Column="2" Width="24" Height="24" VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsSyncing, Mode=OneWay}" />
                    <Button Grid.Column="3" Content="Sync now"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.SyncSteamCommand}" />
                    <Button Grid.Column="4" Content="Manage"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OnManageSteamClick" />
                </Grid>
            </Border>

            <!-- Recently played -->
            <TextBlock Text="Recently Played" Style="{StaticResource SectionTitleStyle}" />

            <TextBlock Text="Aún no hay juegos jugados recientemente."
                       Style="{StaticResource SecondaryTextStyle}"
                       Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />

            <GridView ItemsSource="{x:Bind ViewModel.RecentGames}"
                      SelectionMode="None" IsItemClickEnabled="False">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Game">
                        <Grid Width="440" Height="320" CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                            <!-- Portada -->
                            <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill" />

                            <!-- Degradado inferior para legibilidad -->
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0.35" EndPoint="0.5,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#E60A0D17" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- Último juego + logros -->
                            <Grid Margin="16,14" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind LastPlayedLabel}" FontSize="14" HorizontalAlignment="Left"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border HorizontalAlignment="Right" CornerRadius="8" Padding="10,4"
                                        Background="{StaticResource AccentTintBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{x:Bind AchievementsLabel}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Título, horas y botón -->
                            <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16" Spacing="8">
                                <Border HorizontalAlignment="Left" CornerRadius="8" Padding="10,4" Background="{StaticResource SurfaceAltBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE916;" FontSize="12" />
                                        <TextBlock Text="{x:Bind PlaytimeLabel}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Bind Title}" FontSize="26" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Style="{StaticResource VioletButtonStyle}" Padding="14,6"
                                        Tag="{x:Bind}"
                                        IsEnabled="{x:Bind CanLaunch}"
                                        Click="OnContinueClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                        <TextBlock Text="Continue playing" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
