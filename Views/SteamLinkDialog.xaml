<ContentDialog
    x:Class="Stackd.Views.SteamLinkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Link Steam account"
    PrimaryButtonText="Sign in with Steam"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="520">
        <StackPanel Spacing="14" MinWidth="440" Padding="0,0,12,0">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="Sign in with your Steam account to import your library, playtime and achievements. Stackd never sees your Steam password: you sign in on Steam's own page in your browser." />

            <!-- Solo cuando no hay servidor de Stackd: Steam exige una API key para leer la biblioteca -->
            <Expander x:Name="AdvancedExpander" Header="Advanced: use my own Steam API key"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      IsExpanded="True">
                <StackPanel Spacing="10">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Steam only lets apps read a library with an API key. Enter yours once; it is stored only on this PC." />
                    <PasswordBox x:Name="ApiKeyBox" Header="Steam Web API key"
                                 PlaceholderText="32-character key" />
                    <HyperlinkButton Padding="0" Content="Get your key at steamcommunity.com/dev/apikey"
                                     NavigateUri="https://steamcommunity.com/dev/apikey" />
                </StackPanel>
            </Expander>

            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       Text="In Steam → Profile → Edit Profile → Privacy Settings, “My profile” and “Game details” must be Public." />

            <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                <ProgressRing Width="20" Height="20" IsActive="True" />
                <TextBlock VerticalAlignment="Center" FontSize="13"
                           Text="Waiting for Steam… finish signing in on your browser." />
                <HyperlinkButton Padding="0" Content="Cancel" Click="OnCancelSignInClick" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}"
                       FontSize="13" TextWrapping="Wrap" MaxWidth="420" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
