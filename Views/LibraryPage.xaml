<Page
    x:Class="Stackd.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Stackd.Models"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="40,32,40,0" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="2">
                <TextBlock Text="Library" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnAddClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add game" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Búsqueda y filtros -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search your library"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" Width="160"
                      ItemsSource="{x:Bind ViewModel.StatusFilters}"
                      SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" Width="160"
                      ItemsSource="{x:Bind ViewModel.SortOptions}"
                      SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
        </Grid>

        <!-- Lista -->
        <Grid Grid.Row="2">
            <TextBlock Text="No games here yet. Press “Add game” to register your first one."
                       Style="{StaticResource SecondaryTextStyle}"
                       Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />

            <GridView ItemsSource="{x:Bind ViewModel.Games}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnGameClick"
                      Padding="0,0,0,32">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Game">
                        <StackPanel Width="190" Spacing="8">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Play" Tag="{x:Bind}" Click="OnPlayContextClick"
                                                    Visibility="{x:Bind CanLaunch}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Edit" Tag="{x:Bind}" Click="OnEditContextClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete" Tag="{x:Bind}" Click="OnDeleteContextClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>

                            <Grid Height="253" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
                                <Image Source="{Binding CoverImageUrl}" Stretch="UniformToFill" />
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                        Margin="8" CornerRadius="6" Padding="8,3"
                                        Background="{StaticResource AccentTintBrush}">
                                    <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{x:Bind PlaytimeLabel}" FontSize="12"
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
