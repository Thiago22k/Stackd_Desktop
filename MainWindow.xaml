<Window
    x:Class="Stackd.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Stackd.ViewModels">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Barra lateral ===== -->
        <Grid Background="{StaticResource SidebarBrush}" Padding="12,20,12,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0" Source="ms-appx:///Assets/logotipo.png"
             Width="160" HorizontalAlignment="Left" Margin="12,0,0,20" />

            <!-- Búsqueda (se conectará a IGDB en la fase 3) -->
            <AutoSuggestBox Grid.Row="1" Margin="0,0,0,16"
                            PlaceholderText="Search"
                            QueryIcon="Find" />

            <!-- Navegación principal -->
            <ListView x:Name="MainList" Grid.Row="2"
                      SelectionMode="Single"
                      SelectionChanged="OnNavSelectionChanged">
                <ListView.Resources>
                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AccentBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AccentBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AccentBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="OnAccentBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="OnAccentBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="OnAccentBrush" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="MinHeight" Value="48" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItem">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" />
                            <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Navegación inferior -->
            <ListView x:Name="FooterList" Grid.Row="3"
                      SelectionMode="Single"
                      SelectionChanged="OnNavSelectionChanged">
                <ListView.Resources>
                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AccentBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AccentBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AccentBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="OnAccentBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="OnAccentBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="OnAccentBrush" />
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="MinHeight" Value="48" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItem">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" />
                            <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ===== Contenido ===== -->
        <Frame x:Name="ContentFrame" Grid.Column="1" />
    </Grid>
</Window>
